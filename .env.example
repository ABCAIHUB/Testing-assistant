# Required for dataset generation and llm-rubric grading
ANTHROPIC_API_KEY=

# ── Live auth (default) ──────────────────────────────────────────────────────
# Default chat target is the live Render API (same JSON the UI receives).
# The production UI proxy is optional and equivalent (transparent pass-through):
#   MEZTLI_EVAL_CHAT_URL=https://www.meztli.ai/api/proxy/api/chat
# Promptfoo Output readability comes from transforms/chat-response.js (unwraps
# nested data/result/output), not from hitting the frontend vs backend URL.
#
# Paste a Clerk session JWT from a signed-in browser:
#   1. Open https://www.meztli.ai/assistant and sign in
#   2. DevTools → Network → any /api/proxy request
#   3. Copy Authorization Bearer value (token only, not the word "Bearer")
MEZTLI_EVAL_CLERK_JWT=
# Optional override (defaults to live Render):
# MEZTLI_EVAL_CHAT_URL=https://miraai-backend1.onrender.com/api/chat
# MEZTLI_EVAL_CHAT_URL=https://www.meztli.ai/api/proxy/api/chat
#
# JWT refresh helpers (npm run refresh-jwt) — live Clerk only (sk_live_…):
# MEZTLI_EVAL_CLERK_SECRET=sk_live_...
# MEZTLI_EVAL_CLERK_USER_ID=user_...      # switch users here for different workspace/connectors/quota
# MEZTLI_EVAL_CLERK_SESSION_ID=sess_...   # optional; clear when switching users (auto-picked from active sessions)
# MEZTLI_EVAL_CLERK_JWT_TTL=3600
# On 401, scripts may prompt to refresh when a TTY + secret are present.
# MEZTLI_EVAL_AUTO_REFRESH_JWT=0          # set to disable interactive refresh prompt
#
# Switching users (see docs/CLERK-EVAL-AUTH.md):
#   1. Sign in at https://www.meztli.ai/assistant as that user
#   2. Update MEZTLI_EVAL_CLERK_USER_ID; unset MEZTLI_EVAL_CLERK_SESSION_ID if pinned to old user
#   3. npm run refresh-jwt && npm run preflight
# Billing + connectors are per active workspace — free plan ≈15 queries/month (PLAN_LIMIT).

# ── Timeouts / cold start ────────────────────────────────────────────────────
# MEZTLI_EVAL_WARMUP_MAX_SECS=180   # wait for Render /health before probing
# MEZTLI_EVAL_PROBE_TIMEOUT=180     # seconds for the POST /api/chat probe
# MEZTLI_EVAL_PROBE_RETRIES=1       # extra probe tries on timeout/5xx (uses quota)
# MEZTLI_EVAL_SKIP_PROBE=1          # skip the probe entirely
# REQUEST_TIMEOUT_MS=300000         # promptfoo per-request timeout

# ── Local-only opt-in (NOT for live Render) ──────────────────────────────────
# Eval API key bypass works only when miraai-backend has NODE_ENV≠production.
# Production always returns 401 for this key — do not use it against Render.
# MEZTLI_EVAL_USE_LOCAL=1
# MEZTLI_EVAL_API_KEY=
# MEZTLI_EVAL_CHAT_URL=http://localhost:4000/api/chat
